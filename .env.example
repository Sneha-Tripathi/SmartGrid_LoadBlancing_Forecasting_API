# Smart Grid Load Balancing API - Environment Variables
# Copy this file to .env and customize for your environment.

# --- Application ---
PROJECT_NAME=Smart Grid Load Balancing API
PROJECT_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite:///./smartgrid.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/smartgrid

# --- Authentication ---
SECRET_KEY=your_super_secret_key_change_this_in_production
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Password Policy ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=False
PASSWORD_REQUIRE_LOWERCASE=False
PASSWORD_REQUIRE_DIGIT=False
PASSWORD_REQUIRE_SPECIAL=False

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Brute Force Protection ---
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Monitoring ---
ENABLE_METRICS=True
SLOW_REQUEST_THRESHOLD_MS=1000
ENABLE_REQUEST_LOGGING=True
ENABLE_PROMETHEUS=True
PROMETHEUS_PORT=9090
