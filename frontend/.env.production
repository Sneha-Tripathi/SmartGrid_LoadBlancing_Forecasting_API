# =============================================
# Frontend Production Environment Variables
# =============================================

# Backend API URL — replace with your production backend URL
VITE_API_URL=https://api.smartgrid.example.com

# WebSocket URL — replace with your production WebSocket endpoint
VITE_SOCKET_URL=wss://api.smartgrid.example.com/ws

# Request timeout in milliseconds
VITE_REQUEST_TIMEOUT=10000
