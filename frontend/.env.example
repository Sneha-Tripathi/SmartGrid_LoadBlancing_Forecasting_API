# Frontend Environment Variables for Smart Grid Dashboard
# Copy this file to .env and fill in your values

# Backend API URL (required)
VITE_API_URL=http://localhost:8000

# WebSocket URL (optional, defaults to ws://localhost:8000/ws)
VITE_SOCKET_URL=ws://localhost:8000/ws

# Request timeout in milliseconds (optional, defaults to 10000)
VITE_REQUEST_TIMEOUT=10000
